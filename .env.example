# ─────────────────────────────────────────────────────────────────────────────
# NoviMP — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (Neon PostgreSQL) ----------------------------------------------
# Get from: https://console.neon.tech → your project → Connection String
# Always include ?sslmode=require for Neon
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- Redis -------------------------------------------------------------------
# Local: redis://localhost:6379
# Render Redis: use the connectionString from render.yaml auto-config
REDIS_URL=redis://localhost:6379

# --- JWT ---------------------------------------------------------------------
# Use strong random strings — minimum 32 characters
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Encryption --------------------------------------------------------------
# Must be exactly 32 characters for AES-256-GCM
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=change-me-32-char-key-for-aes-256

# --- App ---------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# --- Email (Resend) ----------------------------------------------------------
# Get your key at https://resend.com
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=NoviMP

# --- Telegram ----------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-bot-token
# Comma-separated Telegram user IDs that get SUPER_ADMIN role on login
# Find your ID via @userinfobot on Telegram — e.g. 123456789,987654321
TELEGRAM_ADMIN_IDS=
# Bot username (without @) shown on the profile Telegram link button
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername

# --- Payment Gateway (Heleket - crypto) --------------------------------------
# Dashboard: https://heleket.com
# Whitelist Heleket webhook IP at your reverse proxy: 31.133.220.8
HELEKET_MERCHANT_ID=your-merchant-id
HELEKET_PAYMENT_KEY=your-payment-api-key
HELEKET_API_URL=https://api.heleket.com

# --- Providers (run add-<provider>.js to seed the DB after first deploy) -----
AUTOSMO_API_KEY=your-autosmo-key
AUTOSMO_API_URL=https://autosmo.com/api/v2
PROXYSELLER_API_KEY=your-proxyseller-api-key
PROXYSELLER_API_URL=https://proxy-seller.com/personal/api/v1
ONLINESIM_API_KEY=your-onlinesim-key
ONLINESIM_API_URL=https://onlinesim.io

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
